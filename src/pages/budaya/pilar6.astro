---
import TravelLayout from '../../layouts/TravelLayout.astro';
import TravelHeader from '../../components/travel/TravelHeader';
import SmoothScroll from '../../components/SmoothScroll';
import TravelFooter from '../../components/travel/TravelFooter';
import Pilar6Content from '../../components/budaya/Pilar6Content';
---

<TravelLayout
	title="Pilar 6: Etos & Perilaku Sosial | Panduan budaya Jogjakarsa"
	description="Kenali gotong royong, tepo seliro, dan kebiasaan sosial untuk berkunjung dengan lebih menghargai kehidupan lokal. Panduan perjalanan Jogjakarsa."
>
	<SmoothScroll client:load />
	<TravelHeader pathname={Astro.url.pathname} client:load />

	<a href="#main-content" class="jk-skip-link">Lewati ke konten utama</a>
	<main id="main-content" class="jk-culture relative isolate">
		<Pilar6Content client:load />

	</main>
	<TravelFooter />
</TravelLayout>
