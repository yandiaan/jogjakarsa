---
import '../styles/global.css';
import '../styles/travel.css';
import BrandMetadata from '../components/travel/BrandMetadata.astro';

interface Props {
	title: string;
 language?: "id" | "en";
	description: string;
}

const { title, description, language = "id" } = Astro.props;
---

<!doctype html>
<html lang={language} class="bg-night text-mist">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
        <link rel="alternate" hreflang="id" href={Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/"} />
        <link rel="alternate" hreflang="en" href={"/en" + ((Astro.url.pathname.replace(/^\/en(?=\/|$)/, "") || "/") === "/" ? "/" : Astro.url.pathname.replace(/^\/en(?=\/|$)/, ""))} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<BrandMetadata language={language} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Manrope:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body class="travel-site min-h-screen bg-night text-mist antialiased selection:bg-sun/30 selection:text-mist">
		<div aria-hidden="true" class="story-grain pointer-events-none fixed inset-0 z-[100]"></div>
		<slot />
	</body>
</html>
